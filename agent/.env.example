# Agent processes (supplier and buyer). Copy to .env and fill. Never commit .env.
ARC_RPC_URL=https://rpc.testnet.arc.io      # confirmed 14 Oct: Circle primary endpoint; Canteen RPC (needs a key) is an alternative
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
INVOICE_BOOK_ADDRESS=                        # from contract/DEPLOYMENTS.md after the deploy

# Circle Agent Wallets (addresses only: the keys are MPC-held by Circle and never exposed).
# Get them with: circle wallet list --chain ARC-TESTNET --type agent
# Login first (email OTP, you must accept the Circle Terms yourself): circle wallet login you@example.com --testnet
SUPPLIER_AGENT_WALLET_ADDRESS=
BUYER_AGENT_WALLET_ADDRESS=

# Each agent runs as its own process and talks to the other only over HTTP.
# Where the supplier agent reaches the buyer agent (the buyer agent's own address; there is no default).
BUYER_AGENT_URL=
SUPPLIER_AGENT_PORT=4101
BUYER_AGENT_PORT=4102
# The Misthos API that receives and verifies the signed decision log. Without it the log stays on this machine.
BACKEND_URL=
# Where each agent keeps its decision log between restarts (gitignored).
AGENT_DATA_DIR=.agent-data

# Model for the strategy layer. There is no fallback model: without a key the agents take no autonomous action.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Or use Groq instead: MODEL_PROVIDER=groq, then set GROQ_API_KEY (console.groq.com/keys). GROQ_MODEL defaults to openai/gpt-oss-120b.
MODEL_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Rung expiry in seconds; use real-world values for pilots.
LADDER_RUNG_SECONDS=900

# Supplier agent private bounds (basis points)
SUPPLIER_COST_OF_WAITING_APR_BPS=2200
SUPPLIER_MAX_RATE_BPS=2400
SUPPLIER_START_RATE_BPS=0
SUPPLIER_STEP_BPS=400

# Buyer agent private policy (USDC as decimal strings, rates in basis points). The hurdle never leaves the buyer process.
BUYER_HURDLE_APR_BPS=0
BUYER_LIQUIDITY_FLOOR=0
BUYER_PER_INVOICE_CAP=0
BUYER_DAILY_CAP=0
BUYER_HUMAN_ABOVE=0
# The most (whole USDC) to send to a supplier with no ERC-8004 feedback yet. Reputation can only lower a limit, never raise one. Empty = no cap for a new address.
BUYER_NEW_ADDRESS_CAP=
# The buyer reads its payment calendar from BACKEND_URL (signed with its wallet). If the calendar cannot be read, nothing is accepted.
# With no BACKEND_URL, set this to true only if you really have no obligations to hold cash for.
BUYER_OBLIGATIONS_DECLARED_NONE=false

# One-time link to your business: make a code on the website (Credit limits page), set it here, start the agent once, then remove it.
# The agent redeems it with a request signed by its own wallet; both halves are needed to link.
MISTHOS_LINK_CODE=
FEE_BPS=1000

# Each agent keeps its own Circle login in its own folder, so logging in as the buyer never overwrites the supplier.
# Use these same folders when you log in: CIRCLE_CLI_HOME=<folder> circle wallet login <email> --testnet
SUPPLIER_CIRCLE_CLI_HOME=C:/Users/YOU/.misthos/circle-supplier
BUYER_CIRCLE_CLI_HOME=C:/Users/YOU/.misthos/circle-buyer

# Agents listen on 127.0.0.1 only. Change AGENT_HOST only if the two agents run on different machines.
AGENT_HOST=127.0.0.1
# Only /health and /negotiate are open to other machines. Settle, plan, policy and decisions need this token from a remote caller (header x-agent-token). Secret: never commit.
AGENT_CONTROL_TOKEN=
# Website origins allowed to call the agents from a browser (comma separated).
# The website origin allowed to read this agent from a browser (for example https://your-site.example). Empty: no browser may.
AGENT_ALLOWED_ORIGINS=

# Encrypts this agent's private files at rest (policy records, decision preimages, the buyer payment calendar). Generate with: openssl rand -base64 32
AGENT_STORE_KEY=

# Supplier: seconds to wait for the buyer agent to answer one offer (default 120). Raise on a slow machine.
# PEER_TIMEOUT_SECONDS=120
