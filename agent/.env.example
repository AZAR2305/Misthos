# Agent processes (supplier and buyer). Copy to .env and fill. Never commit .env.
ARC_RPC_URL=https://rpc.testnet.arc.io      # VERIFY: spec 5.3 names the Canteen-hosted RPC from the ARC CLI
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
INVOICE_BOOK_ADDRESS=                        # from contract/DEPLOYMENTS.md after the deploy

# Circle Agent Wallets (addresses only: the keys are MPC-held by Circle and never exposed).
# Get them with: circle wallet list --chain ARC-TESTNET --type agent
# Login first (email OTP, you must accept the Circle Terms yourself): circle wallet login you@example.com --testnet
SUPPLIER_AGENT_WALLET_ADDRESS=
BUYER_AGENT_WALLET_ADDRESS=

# Each agent runs as its own process and talks to the other only over HTTP.
SUPPLIER_AGENT_URL=http://localhost:4101
BUYER_AGENT_URL=http://localhost:4102

# Model for the strategy layer. There is no fallback model: without a key the agents take no autonomous action.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Rung expiry in seconds; use real-world values for pilots.
LADDER_RUNG_SECONDS=900

# Supplier agent private bounds (basis points)
SUPPLIER_COST_OF_WAITING_APR_BPS=2200
SUPPLIER_MAX_RATE_BPS=5000
SUPPLIER_START_RATE_BPS=0
SUPPLIER_STEP_BPS=200

# Buyer agent private policy (USDC as decimal strings, rates in basis points). The hurdle never leaves the buyer process.
BUYER_HURDLE_APR_BPS=0
BUYER_LIQUIDITY_FLOOR=0
BUYER_PER_INVOICE_CAP=0
BUYER_DAILY_CAP=0
BUYER_HUMAN_ABOVE=0
FEE_BPS=1000

# Each agent keeps its own Circle login in its own folder, so logging in as the buyer never overwrites the supplier.
# Use these same folders when you log in: CIRCLE_CLI_HOME=<folder> circle wallet login <email> --testnet
SUPPLIER_CIRCLE_CLI_HOME=C:/Users/YOU/.misthos/circle-supplier
BUYER_CIRCLE_CLI_HOME=C:/Users/YOU/.misthos/circle-buyer

# Agents listen on 127.0.0.1 only. Change AGENT_HOST only if the two agents run on different machines.
AGENT_HOST=127.0.0.1
# Only /health and /negotiate are open to other machines. Settle, plan, policy and decisions need this token from a remote caller (header x-agent-token). Secret: never commit.
AGENT_CONTROL_TOKEN=
# Website origins allowed to call the agents from a browser (comma separated).
AGENT_ALLOWED_ORIGINS=http://localhost:3000
