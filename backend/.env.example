# Every line is optional. A missing value turns its feature off (see /api/health); it never turns on a fake.
PORT=4000
# postgres://user:pass@host/db  or  pglite://memory  or  pglite://./.data/misthos (default: embedded Postgres in ./.data)
DATABASE_URL=
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
INVOICE_BOOK_ADDRESS=
USDC_ADDRESS=
DEPLOY_BLOCK=0
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web). Add your site as an authorised origin.
# Browser origins allowed to call this API with cookies (comma separated).
FRONTEND_ORIGINS=https://your-site.example
COOKIE_SECURE=false
# Requests per minute per client on sign-in and claim endpoints; set TRUST_PROXY=true behind a proxy that sets X-Forwarded-For.
RATE_LIMIT_PER_MIN=30
TRUST_PROXY=false
# A funded throwaway key that only pays gas to register invoices. Never reuse a key that holds real funds. Secret: never commit.
RELAYER_PRIVATE_KEY=
# What the public stats call this data: pilot or sandbox.

# The two agent wallet addresses (comma separated). Only decision logs signed by these are accepted at /api/log/ingest.
AGENT_WALLETS=
