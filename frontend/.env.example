# Public values only (these are baked into the page at build time). Copy to .env.local.
# Set after you deploy the contract (contract/DEPLOYMENTS.md). Empty shows "Unavailable: not deployed yet".
NEXT_PUBLIC_INVOICE_BOOK_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io
# The Misthos backend (backend/README.md). Leave empty to use the app with just a wallet and no accounts.
NEXT_PUBLIC_API_URL=
# Google OAuth web client id for "Sign in with Google" (console.cloud.google.com > Credentials). Public by design.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The public address of the deployed site (link previews, sitemap, robots). Example: https://misthos.vercel.app
NEXT_PUBLIC_SITE_URL=
