# Contract (Foundry) environment. Copy to .env and fill the empty values. Never commit .env.
# Network constants below are public values (CLAUDE.md section 1, docs.arc.io); secrets are empty.

NETWORK=testnet                          # mainnet refuses to deploy unless CONFIRM_MAINNET=1
ARC_RPC_URL=https://rpc.testnet.arc.io   # VERIFY: spec 5.3 names the Canteen-hosted RPC from the ARC CLI; use that if this one is rate-limited
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io   # VERIFY: spec 12.1 also lists testnet.arcscan.app

# Deployer: pays gas in USDC on Arc. Fund it at https://faucet.circle.com (Arc Testnet).
DEPLOYER_PRIVATE_KEY=

# Optional overrides (defaults: USDC at the Arc address, owner and fee recipient = deployer)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
OWNER=
FEE_RECIPIENT=
CONFIRM_MAINNET=0

# Filled in after deploy (see DEPLOYMENTS.md)
INVOICE_BOOK_ADDRESS=

# Canonical ERC-8004 registries on Arc testnet (used by the agents, not by InvoiceBook)
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
